+
+/* Work below this many multiply-adds is not worth waking the threads. */
+#define PL_PAR_MIN_WORK 262144L
+
+static void pl_conv1d(float *out, const float *x, const float *w,
+                      const float *b, int in_ch, int out_ch, int T,
+                      int K, int dil, int accumulate) {
+    int nt = snt_par_threads();
+    pl_conv_job j;
+    if (nt <= 1 || (long)out_ch * in_ch * K * T < PL_PAR_MIN_WORK) {
+        pl_conv1d_part(out, x, w, b, in_ch, T, K, dil, accumulate, 0, out_ch, 0, T);
+        return;
+    }
+    j.out = out; j.x = x; j.w = w; j.b = b; j.in_ch = in_ch; j.out_ch = out_ch;
+    j.T = T; j.K = K; j.dil = dil; j.accumulate = accumulate;
+    /* Enough rows: split by output channel (small chunks -- big.LITTLE
+     * cores take what they can); a single row (post conv): split by time. */
+    j.by_time = out_ch < 2 * nt;
+    if (j.by_time) {
+        long chunk = T / (4L * nt);
+        snt_par_for(T, chunk < 1024 ? 1024 : chunk, pl_conv1d_run, &j);
+    } else {
+        long chunk = out_ch / (4L * nt);
+        snt_par_for(out_ch, chunk < 1 ? 1 : chunk, pl_conv1d_run, &j);
+    }
+}
