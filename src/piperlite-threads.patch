+                float *orow = out + (long)(oc + o) * T;
+                const float *wr = w + (long)(oc + o) * ws;
+                float bias = b[oc + o];
+                for (t = il; t + PL_VB <= ih; t += PL_VB) {
+                    float a[PL_VB];
+                    for (v = 0; v < PL_VB; v++) a[v] = accumulate ? orow[t + v] + bias : bias;
+                    for (ic = 0; ic < in_ch; ic++) {
+                        const float *xr = x + (long)ic * T + t - pad;
+                        for (k = 0; k < K; k++) {
+                            float wv = wr[ic * K + k];
+                            const float *xp = xr + k * dil;
+                            for (v = 0; v < PL_VB; v++) a[v] += wv * xp[v];
+                        }
+                    }
+                    for (v = 0; v < PL_VB; v++) orow[t + v] = a[v];
+                }
+                if (t < ih) pl_conv1d_edge(out, x, w, b, in_ch, T, K, dil, accumulate, oc + o, oc + o + 1, t, ih);
+            }
+            break;
+        }
+        {
+            float *r0 = out + (long)oc * T, *r1 = r0 + T, *r2 = r1 + T, *r3 = r2 + T;
+            const float *w0 = w + (long)oc * ws, *w1 = w0 + ws, *w2 = w1 + ws, *w3 = w2 + ws;
+            float b0 = b[oc], b1 = b[oc + 1], b2 = b[oc + 2], b3 = b[oc + 3];
+            for (t = il; t + PL_VB <= ih; t += PL_VB) {
+                float a0[PL_VB], a1[PL_VB], a2[PL_VB], a3[PL_VB];
+                for (v = 0; v < PL_VB; v++) {
+                    a0[v] = accumulate ? r0[t + v] + b0 : b0;
+                    a1[v] = accumulate ? r1[t + v] + b1 : b1;
+                    a2[v] = accumulate ? r2[t + v] + b2 : b2;
+                    a3[v] = accumulate ? r3[t + v] + b3 : b3;
+                }
+                for (ic = 0; ic < in_ch; ic++) {
+                    const float *xr = x + (long)ic * T + t - pad;
+                    const float *q0 = w0 + ic * K, *q1 = w1 + ic * K, *q2 = w2 + ic * K, *q3 = w3 + ic * K;
+                    for (k = 0; k < K; k++) {
+                        const float *xp = xr + k * dil;
+                        float c0 = q0[k], c1 = q1[k], c2 = q2[k], c3 = q3[k];
+                        for (v = 0; v < PL_VB; v++) {
+                            float xv = xp[v];
+                            a0[v] += c0 * xv;
+                            a1[v] += c1 * xv;
+                            a2[v] += c2 * xv;
+                            a3[v] += c3 * xv;
+                        }
+                    }
+                }
+                for (v = 0; v < PL_VB; v++) { r0[t + v] = a0[v]; r1[t + v] = a1[v]; r2[t + v] = a2[v]; r3[t + v] = a3[v]; }
+            }
+            if (t < ih) pl_conv1d_edge(out, x, w, b, in_ch, T, K, dil, accumulate, oc, oc + PL_OB, t, ih);
+        }
+    }
+}
