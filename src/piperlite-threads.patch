+#define PL_VB 8            /* samples per register block */
+#define PL_OB 4            /* output rows per register block */
+
+/* Interior samples (every tap inside the row): PL_OB rows x PL_VB samples
+ * are kept in registers while all (ic, k) taps are added -- in the same
+ * order (ic ascending, then k) as the plain loop, so each value is the
+ * same bit for bit; the row is read and written once instead of in_ch*K
+ * times. */
+static void pl_conv1d_part(float *out, const float *x, const float *w,
+                           const float *b, int in_ch, int T, int K, int dil,
+                           int accumulate, int oc_lo, int oc_hi, int t0, int t1) {
+    int pad = dil * (K / 2);
+    int il = t0 > pad ? t0 : pad, ih = t1 < T - pad ? t1 : T - pad;
+    int oc, ic, k, t, v, o;
+    long ws = (long)in_ch * K;
+    if (il >= ih) { pl_conv1d_edge(out, x, w, b, in_ch, T, K, dil, accumulate, oc_lo, oc_hi, t0, t1); return; }
+    pl_conv1d_edge(out, x, w, b, in_ch, T, K, dil, accumulate, oc_lo, oc_hi, t0, il);
